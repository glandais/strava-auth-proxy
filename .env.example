# Copy to .env and fill in. .env is git-ignored; this template is committed.
#
#   cp .env.example .env
#
# Every variable here is also a plain environment variable, so this file is
# only a convenience for docker compose. The full reference is in README.md.

# --- Real Strava application (never leaves the proxy) ---------------------
# From https://www.strava.com/settings/api. The Authorization Callback Domain
# registered there MUST be the host of PROXY_PUBLIC_URL below — that is what
# lets Strava redirect back to this proxy's /oauth/callback.
STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=replace-me

# Alternative for orchestrated secrets: point at a mounted file instead, and
# leave STRAVA_CLIENT_SECRET unset.
# STRAVA_CLIENT_SECRET_FILE=/run/secrets/strava_client_secret

# --- Proxy identity ------------------------------------------------------
# The externally reachable base URL, exactly as callers and Strava see it.
# No trailing slash. Used to build the /oauth/callback redirect_uri.
PROXY_PUBLIC_URL=https://proxy.example

# --- State signing key ring ----------------------------------------------
# Seals the OAuth state and the wrapped authorization codes. Newest key first,
# comma-separated, "kid=hex". At least 32 bytes (64 hex chars) each.
# Generate one with:
#   echo "k1=$(head -c32 /dev/urandom | xxd -p -c64)"
# Rotation: prepend a new kid, keep the old one listed for at least
# PROXY_STATE_TTL, then drop it. See the runbook in README.md.
PROXY_STATE_KEYS=k1=replace-me-with-64-hex-chars

# Lifetime of a sealed state / wrapped code. Optional, defaults to 15m.
# PROXY_STATE_TTL=15m

# --- TLS -----------------------------------------------------------------
# Pick ONE of the two blocks below.
#
# (a) Behind a TLS-terminating ingress or reverse proxy. The listener speaks
#     plain HTTP, which the proxy refuses unless you say so explicitly.
#     Only safe when nothing untrusted can reach the container port directly:
#     the OAuth codes and client secrets crossing this hop are unencrypted.
DEV_ALLOW_HTTP=true
#
# (b) The proxy terminates TLS itself. Uncomment the matching volumes in
#     compose.yaml, and remove DEV_ALLOW_HTTP above.
# TLS_CERT_FILE=/etc/strava-auth-proxy/tls/fullchain.pem
# TLS_KEY_FILE=/etc/strava-auth-proxy/tls/privkey.pem

# --- Misc ----------------------------------------------------------------
# debug | info | warn | error. Defaults to info.
# LOG_LEVEL=info

# Host port the container's 8443 is published on (read by compose.yaml).
# PROXY_PORT=8443

# Image tag / build arg (read by compose.yaml).
# VERSION=dev
